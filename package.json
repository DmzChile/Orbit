{
  "name": "orbit-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Orbit \u2014 Windows personal workspace",
  "author": "Orbit contributors",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/licenses.mjs && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src worker tests scripts",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "start": "electron .",
    "package": "npm run build && electron-builder --win nsis --x64",
    "package:dir": "npm run build && electron-builder --win dir --x64",
    "worker": "node dist/worker.mjs",
    "format": "prettier --write src worker tests scripts *.ts *.mjs package.json",
    "test:packaged": "node scripts/packaged-smoke.mjs"
  },
  "build": {
    "appId": "io.orbit.workspace",
    "productName": "Orbit",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json",
      "resources/**",
      "docs/SETUP.md"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "resources/orbit.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "jszip": "3.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pdfkit": "0.17.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "pdfkit": "0.20.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
